// Lotproof: a supplier proves to its customer how many parts of a lot are
// inside the drawing tolerance, without handing over the raw measurements.
//
// One contract per supplier-customer relationship. Two roles hold keys:
//   - the customer publishes drawing specs (tolerance band and its own
//     acceptance number), approves each measuring station for one spec, and
//     can later ask audit questions about any committed lot;
//   - the supplier proves lots, answers audits and, if a part is disputed,
//     discloses it.
//
// Flow:
//   1. The customer publishes a spec and approves a measuring station for it.
//   2. The station commits the lot's raw measurements at measuring time, under
//      the spec it was approved for. The commitment binds the lot id and the
//      spec id. After this the values cannot change.
//   3. The supplier proves, against that commitment, how many parts are inside
//      the band. Only the count and the verdict reach the ledger.
//   4. At any later time the customer can publish a new band (an audit spec)
//      and request an audit of a committed lot. The supplier proves the count
//      against the new band from the same commitment, without measuring again
//      and without revealing values. Open requests are public, so an
//      unanswered audit is visible.
//   5. If the customer disputes one part of a proven lot, the supplier can
//      disclose that single value, proven to belong to the committed lot.
//
// Lot and spec ids are opaque 32-byte values. The demo derives them off-chain
// with a keyed hash, so labels such as drawing numbers never reach the ledger.
//
// Identities are hashes of witness secrets (never ownPublicKey()), domain
// separated per role.

pragma language_version 0.28;
import CompactStandardLibrary;

export enum LotStatus { Committed, Accepted, Rejected }

export struct Spec {
    // All lengths in micrometres (um) to stay in unsigned integers.
    nominal: Uint<32>;
    lower: Uint<32>;
    upper: Uint<32>;
    maxDefects: Uint<8>;
}

export struct Lot {
    specId: Bytes<32>;
    station: Bytes<32>;
    commitment: Bytes<32>;
    status: LotStatus;
    inTolerance: Uint<8>;
    sampleSize: Uint<8>;
}

export struct Audit {
    lotId: Bytes<32>;
    specId: Bytes<32>;
    answered: Boolean;
    inTolerance: Uint<8>;
}

export ledger admin: Bytes<32>;
export ledger customer: Bytes<32>;
// station key -> the one spec it is approved to measure.
export ledger stations: Map<Bytes<32>, Bytes<32>>;
export ledger specs: Map<Bytes<32>, Spec>;
export ledger lots: Map<Bytes<32>, Lot>;
// lotId -> (part index -> disclosed value). Only parts the supplier chose to reveal.
export ledger disclosed: Map<Bytes<32>, Map<Uint<8>, Uint<32>>>;
// committedLots - provenLots = lots measured but not yet proven, visible to the customer.
export ledger committedLots: Counter;
export ledger provenLots: Counter;
// auditKey(lotId, specId) -> audit. requestedAudits - answeredAudits = audits still open.
export ledger audits: Map<Bytes<32>, Audit>;
export ledger requestedAudits: Counter;
export ledger answeredAudits: Counter;

witness adminSecret(): Bytes<32>;
witness customerSecret(): Bytes<32>;
witness stationSecret(): Bytes<32>;
witness lotMeasurements(lotId: Bytes<32>): Vector<32, Uint<32>>;
witness lotSalt(lotId: Bytes<32>): Bytes<32>;

export pure circuit adminKey(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "lotproof:admin:v1"), sk]);
}

export pure circuit customerKey(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "lotproof:customer:v1"), sk]);
}

export pure circuit stationKey(sk: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<2, Bytes<32>>>([pad(32, "lotproof:station:v1"), sk]);
}

// Hiding commitment to one lot. The salt is the commitment randomness; the lot
// and spec ids are inside, so a commitment only ever opens for its own lot.
export pure circuit lotCommitment(lotId: Bytes<32>, specId: Bytes<32>,
                                  values: Vector<32, Uint<32>>, salt: Bytes<32>): Bytes<32> {
    return persistentCommit<[Bytes<32>, Bytes<32>, Bytes<32>, Vector<32, Uint<32>>]>(
        [pad(32, "lotproof:lot:v2"), lotId, specId, values], salt);
}

export pure circuit auditKey(lotId: Bytes<32>, specId: Bytes<32>): Bytes<32> {
    return persistentHash<Vector<3, Bytes<32>>>([pad(32, "lotproof:audit:v1"), lotId, specId]);
}

export pure circuit countInTolerance(values: Vector<32, Uint<32>>, lower: Uint<32>, upper: Uint<32>): Uint<8> {
    return fold((acc: Uint<8>, v: Uint<32>): Uint<8> =>
        (v >= lower && v <= upper) ? (acc + 1) as Uint<8> : acc,
        0 as Uint<8>, values);
}

// Vectors cannot be indexed with a runtime value, so walk the lot once and
// keep the value whose position matches.
export pure circuit pickPart(values: Vector<32, Uint<32>>, index: Uint<8>): Uint<32> {
    const r = fold((acc: [Uint<8>, Uint<32>], v: Uint<32>): [Uint<8>, Uint<32>] =>
        [(acc[0] + 1) as Uint<8>, acc[0] == index ? v : acc[1]],
        [0 as Uint<8>, 0 as Uint<32>], values);
    return r[1];
}

// The supplier deploys; the customer's public key is fixed at deployment.
constructor(customerPk: Bytes<32>) {
    admin = disclose(adminKey(adminSecret()));
    customer = disclose(customerPk);
}

circuit assertAdmin(): [] {
    assert(admin == disclose(adminKey(adminSecret())), "Only the supplier admin can do this");
}

circuit assertCustomer(): [] {
    assert(customer == disclose(customerKey(customerSecret())), "Only the customer can do this");
}

export circuit registerStation(station: Bytes<32>, specId: Bytes<32>): [] {
    assertCustomer();
    const st = disclose(station);
    const sp = disclose(specId);
    assert(specs.member(sp), "Unknown spec");
    assert(!stations.member(st), "Station already approved");
    stations.insert(st, sp);
}

export circuit revokeStation(station: Bytes<32>): [] {
    assertCustomer();
    const st = disclose(station);
    assert(stations.member(st), "Station not registered");
    stations.remove(st);
}

export circuit publishSpec(specId: Bytes<32>, spec: Spec): [] {
    assertCustomer();
    const id = disclose(specId);
    const s = disclose(spec);
    assert(!specs.member(id), "Spec id already used");
    assert(s.lower <= s.nominal && s.nominal <= s.upper, "Nominal must sit inside the band");
    assert(s.maxDefects <= 32, "Acceptance number larger than the sample");
    specs.insert(id, s);
}

// Called by the measuring station right after measuring. Values stay on the
// station; only the commitment is published. The spec is the one the customer
// approved this station for, so the station cannot pick a wider band.
export circuit commitLot(lotId: Bytes<32>): [] {
    const st = disclose(stationKey(stationSecret()));
    assert(stations.member(st), "Station not registered");
    const sp = stations.lookup(st);
    const id = disclose(lotId);
    assert(!lots.member(id), "Lot already committed");
    const c = disclose(lotCommitment(lotId, sp, lotMeasurements(lotId), lotSalt(lotId)));
    lots.insert(id, Lot {
        specId: sp,
        station: st,
        commitment: c,
        status: LotStatus.Committed,
        inTolerance: 0,
        sampleSize: 32
    });
    committedLots.increment(1);
}

// The supplier proves the verdict. The circuit recomputes the commitment from
// the private values, checks it against the station's and counts the values
// against the band.
export circuit proveLot(lotId: Bytes<32>): [] {
    assertAdmin();
    const id = disclose(lotId);
    assert(lots.member(id), "Unknown lot");
    const lot = lots.lookup(id);
    assert(lot.status == LotStatus.Committed, "Lot already proven");
    const spec = specs.lookup(lot.specId);
    const values = lotMeasurements(lotId);
    assert(lotCommitment(lotId, lot.specId, values, lotSalt(lotId)) == lot.commitment,
           "Measurements do not match the station commitment");
    const ok = disclose(countInTolerance(values, spec.lower, spec.upper));
    const accepted = (32 - ok) as Uint<8> <= spec.maxDefects;
    lots.insert(id, Lot {
        specId: lot.specId,
        station: lot.station,
        commitment: lot.commitment,
        status: accepted ? LotStatus.Accepted : LotStatus.Rejected,
        inTolerance: ok,
        sampleSize: 32
    });
    provenLots.increment(1);
}

// Selective disclosure of one disputed part. The value is proven to be the
// one inside the committed lot; the other 31 stay private.
export circuit disclosePart(lotId: Bytes<32>, index: Uint<8>): [] {
    assertAdmin();
    const id = disclose(lotId);
    const i = disclose(index);
    assert(lots.member(id), "Unknown lot");
    assert(i < 32, "Part index out of range");
    const lot = lots.lookup(id);
    assert(lot.status != LotStatus.Committed, "Lot not proven yet");
    const values = lotMeasurements(lotId);
    assert(lotCommitment(lotId, lot.specId, values, lotSalt(lotId)) == lot.commitment,
           "Measurements do not match the station commitment");
    const v = disclose(pickPart(values, i));
    if (!disclosed.member(id)) {
        disclosed.insert(id, default<Map<Uint<8>, Uint<32>>>);
    }
    assert(!disclosed.lookup(id).member(i), "Part already disclosed");
    disclosed.lookup(id).insert(i, v);
}

// The customer asks a new question about a committed lot: how many parts sit
// inside the band of another spec (for example a tighter audit band).
export circuit requestAudit(lotId: Bytes<32>, specId: Bytes<32>): [] {
    assertCustomer();
    const id = disclose(lotId);
    const sp = disclose(specId);
    assert(lots.member(id), "Unknown lot");
    assert(specs.member(sp), "Unknown spec");
    const k = auditKey(id, sp);
    assert(!audits.member(k), "Audit already requested");
    audits.insert(k, Audit { lotId: id, specId: sp, answered: false, inTolerance: 0 });
    requestedAudits.increment(1);
}

// The supplier answers from the same commitment: no new measurement, no values
// revealed, only the count against the audit band.
export circuit answerAudit(lotId: Bytes<32>, specId: Bytes<32>): [] {
    assertAdmin();
    const id = disclose(lotId);
    const sp = disclose(specId);
    const k = auditKey(id, sp);
    assert(audits.member(k), "No audit requested");
    assert(!audits.lookup(k).answered, "Audit already answered");
    const lot = lots.lookup(id);
    const values = lotMeasurements(lotId);
    assert(lotCommitment(lotId, lot.specId, values, lotSalt(lotId)) == lot.commitment,
           "Measurements do not match the station commitment");
    const spec = specs.lookup(sp);
    const ok = disclose(countInTolerance(values, spec.lower, spec.upper));
    audits.insert(k, Audit { lotId: id, specId: sp, answered: true, inTolerance: ok });
    answeredAudits.increment(1);
}
